{
  "compilerOptions": {
    "target": "es2023",
    // `RegExp.escape` (Node 24 has it: `vite.config.ts`, the repo's `vitest.utils.ts`).
    "lib": ["es2023", "ES2025.RegExp", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": [".storybook", "vite.config.ts"]
}
