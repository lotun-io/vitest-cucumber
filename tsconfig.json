{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // @tsconfig/node24's, and `RegExp.escape` (Node 24 has it).
    "lib": [
      "es2024",
      "ES2025.RegExp",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts"],
  "exclude": ["example", "tmp", "storybook", "docs"]
}
