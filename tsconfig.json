{
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The base leaves it to TypeScript's default.
    "strict": true,
    // Node 24's, the lowest Node the package supports (`engines`), not the base's (Node 26's:
    // `Temporal`, which Node 24 doesn't have): `@tsconfig/node24`'s list, and `RegExp.escape`.
    "lib": [
      "es2024",
      "ES2025.RegExp",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts"],
  "exclude": ["example", "tmp", "storybook", "docs"]
}
