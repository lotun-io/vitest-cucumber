{
  "name": "@lotun/vitest-cucumber",
  "version": "0.4.3",
  "description": "Vitest plugin for Cucumber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lotun-io/vitest-cucumber"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "vitest",
    "cucumber",
    "gherkin",
    "testing",
    "bdd",
    "plugin",
    "vite-plugin"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__*__/**"
  ],
  "scripts": {
    "lint": "tsc && pnpm lint:prettier && pnpm lint:eslint",
    "lint:prettier": "prettier --check src",
    "lint:eslint": "eslint",
    "format": "prettier --write src && eslint --fix",
    "build": "tsdown",
    "test": "vitest run --coverage --coverage.reporter=text-summary",
    "ci:publish": "pnpm build && pnpm publish --provenance --access public --no-git-checks"
  },
  "dependencies": {
    "stream-chain": "^4.2.5",
    "string-argv": "^0.3.2",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "@cucumber/cucumber": "12.x || 13.x",
    "@cucumber/messages": "32.x",
    "@cucumber/query": "15.x",
    "vitest": "4.x"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@cucumber/cucumber": "^13.0.0",
    "@cucumber/messages": "^32.3.1",
    "@cucumber/query": "^15.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-plugin-n": "^18.2.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
