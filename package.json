{
  "name": "@lotun/vitest-cucumber",
  "version": "1.0.0-beta.4",
  "description": "Vitest plugin for Cucumber",
  "license": "MIT",
  "homepage": "https://lotun-io.github.io/vitest-cucumber/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lotun-io/vitest-cucumber.git"
  },
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "keywords": [
    "vitest",
    "cucumber",
    "gherkin",
    "testing",
    "bdd",
    "plugin",
    "vite-plugin",
    "storybook"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./storybook": {
      "import": "./src/worker/storybook/index.ts"
    },
    "./storybook/node": {
      "import": "./src/core/storybook/node.ts"
    },
    "./storybook/preset": {
      "import": "./src/core/storybook/preset.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./storybook": {
        "types": "./dist/worker/storybook/index.d.mts",
        "import": "./dist/worker/storybook/index.mjs"
      },
      "./storybook/node": {
        "types": "./dist/core/storybook/node.d.mts",
        "import": "./dist/core/storybook/node.mjs"
      },
      "./storybook/preset": {
        "import": "./dist/core/storybook/preset.mjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__*__/**"
  ],
  "scripts": {
    "lint": "tsc && pnpm lint:prettier && pnpm lint:eslint",
    "lint:prettier": "prettier --check src e2e compatibility",
    "lint:eslint": "eslint",
    "format": "prettier --write src e2e compatibility && eslint --fix",
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "vitest run --coverage --coverage.reporter=text-summary",
    "compatibility:generate": "node compatibility/utils/generate.ts",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "ci:publish": "pnpm publish --provenance --access public --no-git-checks"
  },
  "peerDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "storybook": "^10.6.0",
    "vitest": "^5.x"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cucumber/compatibility-kit": "^31.0.0",
    "@cucumber/cucumber": "catalog:",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "5.1.0",
    "amaro": "^1.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-n": "^18.5.0",
    "jiti": "^2.7.0",
    "playwright": "1.64.1",
    "prettier": "^3.10.1",
    "prettier-plugin-gherkin": "^4.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "storybook": "catalog:",
    "tsdown": "^0.23.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.74.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@cucumber/core": "0.10.0",
    "@cucumber/cucumber-expressions": "^20.2.0",
    "@cucumber/gherkin": "catalog:",
    "@cucumber/messages": "catalog:",
    "@cucumber/query": "^16.4.0",
    "@cucumber/tag-expressions": "^11.2.0",
    "@vitest/utils": "^5.1.1",
    "magic-string": "^1.4.5",
    "tinyglobby": "^0.2.17",
    "uuid": "^14.0.3"
  }
}
