{
  "name": "@lotun/vitest-cucumber",
  "version": "0.2.2",
  "description": "Vitest plugin for Cucumber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lotun-io/vitest-cucumber"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "vitest",
    "cucumber",
    "gherkin",
    "testing",
    "bdd",
    "plugin"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__*__/**"
  ],
  "scripts": {
    "lint": "tsc && pnpm lint:prettier && pnpm lint:eslint",
    "lint:prettier": "prettier --check src",
    "lint:eslint": "eslint",
    "format": "prettier --write src && eslint --fix",
    "build": "tsdown",
    "test": "vitest run --coverage --coverage.reporter=text-summary",
    "ci:publish": "pnpm build && pnpm publish --provenance --access public --no-git-checks"
  },
  "dependencies": {
    "@cucumber/gherkin": "^38.0.0",
    "@cucumber/messages": "^32.3.1",
    "@cucumber/query": "^15.0.1",
    "glob": "^13.0.6",
    "string-argv": "^0.3.2"
  },
  "peerDependencies": {
    "@cucumber/cucumber": "^12.x",
    "@cucumber/gherkin": "^38.x",
    "@cucumber/messages": "^32.x",
    "@cucumber/query": "^15.x",
    "vitest": "^4.x"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@cucumber/cucumber": "^12.9.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-plugin-n": "^18.0.1",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
