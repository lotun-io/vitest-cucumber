{
  "name": "@lotun/vitest-cucumber",
  "version": "0.5.4",
  "description": "Vitest plugin for Cucumber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lotun-io/vitest-cucumber"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "vitest",
    "cucumber",
    "gherkin",
    "testing",
    "bdd",
    "plugin",
    "vite-plugin"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./browser": {
      "import": "./src/browser/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      },
      "./browser": {
        "import": "./dist/browser/index.mjs",
        "types": "./dist/browser/index.d.mts"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__*__/**"
  ],
  "scripts": {
    "lint": "tsc && pnpm lint:prettier && pnpm lint:eslint",
    "lint:prettier": "prettier --check src",
    "lint:eslint": "eslint",
    "format": "prettier --write src && eslint --fix",
    "build": "tsdown",
    "test": "vitest run --coverage --coverage.reporter=text-summary",
    "ci:publish": "pnpm build && pnpm publish --provenance --access public --no-git-checks"
  },
  "dependencies": {
    "@cucumber/messages": "^34.2.1",
    "@cucumber/query": "^16.1.1",
    "stream-chain": "^4.2.5",
    "string-argv": "^0.3.2",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "@cucumber/cucumber": "12.x || 13.x",
    "vitest": "4.x || 5.x"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@cucumber/cucumber": "^13.2.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.4.1",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-n": "^18.3.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-gherkin": "^4.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
